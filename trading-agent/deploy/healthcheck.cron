# Every 5 minutes: alert if the engine is dead, stale, halted or killed.
# Replace the alert command with your own (email, Pushover, ntfy, Slack webhook...).
*/5 * * * * cd /opt/trading-agent && python3 -m tradeagent healthcheck --max-age 300 || echo "tradeagent UNHEALTHY" | mail -s "tradeagent alert" you@example.com
